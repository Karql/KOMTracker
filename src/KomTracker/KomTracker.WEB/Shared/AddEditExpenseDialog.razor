@using System.Net.Http.Json
@using System.Threading
@using KomTracker.API.Shared.ViewModels.Expense
@using KomTracker.API.Shared.ViewModels.Suggestions
@using KomTracker.Domain.Entities.Expense
@using KomTracker.WEB.Infrastructure
@using KomTracker.WEB.Models.Expense

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required"
                          MaxLength="200" Immediate="true" />

            <MudAutocomplete T="ExpenseCategory?" @bind-Value="_categoryValue" Label="Category" Class="mt-3"
                             Placeholder="Search category" Required="true" RequiredError="Category is required"
                             SearchFunc="SearchCategories" MaxItems="@((int?)null)"
                             ResetValueOnEmptyText="false" CoerceValue="false" SelectValueOnTab="true"
                             Adornment="Adornment.Start" AdornmentColor="Color.Default"
                             AdornmentIcon="@(_categoryValue is null ? Icons.Material.Filled.Category : ExpenseCategoryIcons.Icon(_categoryValue.Value))"
                             ToStringFunc="@(c => c is null ? string.Empty : ExpenseCategoryMetadata.DisplayName(c.Value))">
                <ItemTemplate Context="category">
                    <div class="d-flex align-center" style="gap: 8px; width: 100%;">
                        <MudIcon Icon="@ExpenseCategoryIcons.Icon(category!.Value)" Size="Size.Small" />
                        <span>@ExpenseCategoryMetadata.DisplayName(category.Value)</span>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@ExpenseCategoryMetadata.DisplayName(ExpenseCategoryMetadata.Group(category.Value))</MudText>
                    </div>
                </ItemTemplate>
            </MudAutocomplete>

            <MudNumericField @bind-Value="_price" Label="Price" Min="0" Class="mt-3" Converter="InputConverters.Decimal"
                             Required="true" RequiredError="Price is required" />
            <MudDatePicker @bind-Date="_purchaseDate" Label="Purchase date" Class="mt-3" DateFormat="yyyy-MM-dd" Editable="true"
                           Required="true" RequiredError="Purchase date is required" />
            <MudAutocomplete T="string" @bind-Value="_model.PurchasePlace" Label="Purchase place" Class="mt-3"
                             SearchFunc="SearchPlaces" CoerceValue="true" Clearable="true" MaxItems="@((int?)null)" />
            <MudTextField @bind-Value="_model.Notes" Label="Notes" Lines="3" MaxLength="2000" Class="mt-3" />

            @if (Expense?.Lifecycle == ExpenseLifecycle.Sold)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Sale</MudText>
                <MudDatePicker @bind-Date="_saleDate" Label="Sale date" Class="mt-3" DateFormat="yyyy-MM-dd" Editable="true" />
                <MudNumericField @bind-Value="_model.SalePrice" Label="Sale price" Min="0" Class="mt-3" Converter="InputConverters.Decimal" />
                <MudAutocomplete T="string" @bind-Value="_model.SalePlace" Label="Sale place" Class="mt-3"
                                 SearchFunc="SearchSalePlaces" CoerceValue="true" Clearable="true" MaxItems="@((int?)null)" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null = add; non-null = edit.</summary>
    [Parameter] public ExpenseViewModel? Expense { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private SaveExpenseViewModel _model = new();
    private ExpenseCategory? _categoryValue;   // null until picked (placeholder shown; Required-guarded)
    private decimal? _price;
    private DateTime? _purchaseDate = DateTime.Today;
    private DateTime? _saleDate;
    private PurchaseSuggestionsViewModel _suggestions = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _suggestions = await Http.GetFromJsonAsync<PurchaseSuggestionsViewModel>("bike-tracker/suggestions")
            ?? new PurchaseSuggestionsViewModel();

        if (Expense is not null)
        {
            _model = new SaveExpenseViewModel
            {
                Name = Expense.Name,
                Category = Expense.Category,
                Price = Expense.Price,
                PurchaseDate = Expense.PurchaseDate,
                PurchasePlace = Expense.PurchasePlace,
                Notes = Expense.Notes,
                SaleDate = Expense.SaleDate,
                SalePrice = Expense.SalePrice,
                SalePlace = Expense.SalePlace
            };
            _categoryValue = Expense.Category;
            _price = Expense.Price;
            _purchaseDate = Expense.PurchaseDate;
            _saleDate = Expense.SaleDate;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _model.Category = _categoryValue!.Value;
        _model.Price = _price ?? 0;
        _model.PurchaseDate = _purchaseDate!.Value;
        _model.SaleDate = _saleDate;
        _saving = true;

        try
        {
            var response = Expense is null
                ? await Http.PostAsJsonAsync("expenses", _model)
                : await Http.PutAsJsonAsync($"expenses/{Expense.Id}", _model);

            if (response.IsSuccessStatusCode)
            {
                var saved = await response.Content.ReadFromJsonAsync<ExpenseViewModel>();
                Snackbar.Add(Expense is null ? "Expense added" : "Expense updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(saved));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task<IEnumerable<ExpenseCategory?>> SearchCategories(string value, CancellationToken token)
    {
        var all = ExpenseCategoryMetadata.CategoriesByGroup()
            .SelectMany(g => g.Categories)
            .Select(c => (ExpenseCategory?)c);

        if (!string.IsNullOrWhiteSpace(value))
        {
            all = all.Where(c =>
                ExpenseCategoryMetadata.DisplayName(c!.Value).Contains(value, StringComparison.OrdinalIgnoreCase)
                || ExpenseCategoryMetadata.DisplayName(ExpenseCategoryMetadata.Group(c.Value)).Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(all);
    }

    private Task<IEnumerable<string>> SearchPlaces(string value, CancellationToken token) => Suggest(_suggestions.PurchasePlaces, value);
    private Task<IEnumerable<string>> SearchSalePlaces(string value, CancellationToken token) => Suggest(_suggestions.SalePlaces, value);

    private static Task<IEnumerable<string>> Suggest(IEnumerable<string> source, string value)
        => Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? source
            : source.Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void Cancel() => MudDialog.Cancel();
}
