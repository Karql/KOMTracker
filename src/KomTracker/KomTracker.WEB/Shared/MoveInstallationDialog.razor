@using System.Net.Http.Json
@using KomTracker.API.Shared.ViewModels.Bike
@using KomTracker.API.Shared.ViewModels.Installation
@using KomTracker.Domain.Entities.Component
@using KomTracker.WEB.Infrastructure

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Move <b>@Installation.ComponentName</b> to another bike. The current window is closed and a new one opens on the move date.
        </MudText>
        <MudForm @ref="_form">
            <MudSelect T="int?" @bind-Value="_newBikeId" Label="New bike" Required="true" RequiredError="Pick a bike">
                @foreach (var bike in _bikes)
                {
                    <MudSelectItem T="int?" Value="@bike.Id">@bike.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="InstallationPosition?" @bind-Value="_position" Label="Position" Clearable="true" Class="mt-3">
                @foreach (var pos in Enum.GetValues<InstallationPosition>())
                {
                    <MudSelectItem T="InstallationPosition?" Value="@pos">@pos</MudSelectItem>
                }
            </MudSelect>

            <div class="d-flex" style="gap: 12px;">
                <MudDatePicker @bind-Date="_moveDate" Label="Move date" Required="true"
                               RequiredError="Move date is required" Class="mt-3" Style="flex: 2;" />
                <MudTimePicker @bind-Time="_moveTime" Label="Time" Class="mt-3" Style="flex: 1;" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Move</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public InstallationViewModel Installation { get; set; } = default!;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private int? _newBikeId;
    private InstallationPosition? _position;
    private DateTime? _moveDate = DateTime.UtcNow.Date;
    private TimeSpan? _moveTime = TimeSpan.Zero;
    private bool _saving;
    private IEnumerable<BikeViewModel> _bikes = Enumerable.Empty<BikeViewModel>();

    protected override async Task OnInitializedAsync()
    {
        _bikes = await Http.GetFromJsonAsync<BikeViewModel[]>("bikes")
            ?? Enumerable.Empty<BikeViewModel>();
        _position = Installation.Position;
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _newBikeId is null)
        {
            return;
        }

        var body = new MoveInstallationViewModel
        {
            NewBikeId = _newBikeId.Value,
            NewPosition = _position,
            MoveDate = _moveDate!.Value.Date + (_moveTime ?? TimeSpan.Zero)
        };

        _saving = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"installations/{Installation.Id}/move", body);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Component moved", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
