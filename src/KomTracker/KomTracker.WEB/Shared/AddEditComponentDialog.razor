@using System.Net.Http.Json
@using System.Threading
@using KomTracker.API.Shared.ViewModels.Component
@using KomTracker.API.Shared.ViewModels.Warehouse
@using KomTracker.Domain.Entities.Component
@using KomTracker.WEB.Infrastructure
@using KomTracker.WEB.Models.Component

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required"
                          MaxLength="200" Immediate="true" />

            <MudAutocomplete T="ComponentCategory?" @bind-Value="_categoryValue" Label="Category" Class="mt-3"
                             Placeholder="Search component type" Required="true" RequiredError="Category is required"
                             SearchFunc="SearchCategories" MaxItems="@((int?)null)"
                             ResetValueOnEmptyText="false" CoerceValue="false" SelectValueOnTab="true"
                             Adornment="Adornment.Start" AdornmentColor="Color.Default"
                             AdornmentIcon="@(_categoryValue is null ? Icons.Material.Filled.Category : ComponentCategoryIcons.Icon(_categoryValue.Value))"
                             ToStringFunc="@(c => c is null ? string.Empty : ComponentCategoryMetadata.DisplayName(c.Value))">
                <ItemTemplate Context="category">
                    <div class="d-flex align-center" style="gap: 8px; width: 100%;">
                        <MudIcon Icon="@ComponentCategoryIcons.Icon(category!.Value)" Size="Size.Small" />
                        <span>@ComponentCategoryMetadata.DisplayName(category.Value)</span>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@ComponentCategoryMetadata.DisplayName(ComponentCategoryMetadata.Group(category.Value))</MudText>
                    </div>
                </ItemTemplate>
            </MudAutocomplete>

            <MudTextField @bind-Value="_model.Brand" Label="Brand" MaxLength="200" Class="mt-3" />
            <MudTextField @bind-Value="_model.Model" Label="Model" MaxLength="200" Class="mt-3" />

            <MudSelect T="int?" @bind-Value="_model.WarehouseId" Label="Warehouse" Clearable="true" Class="mt-3">
                <MudSelectItem T="int?" Value="@((int?)null)">— None —</MudSelectItem>
                @foreach (var warehouse in _warehouses)
                {
                    <MudSelectItem T="int?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                }
            </MudSelect>
            @if (!_warehouses.Any())
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    No warehouses yet — <MudLink Href="warehouses" Typo="Typo.caption">create one</MudLink> to store this component.
                </MudText>
            }

            <MudExpansionPanels Elevation="0" Class="mt-3">
                <MudExpansionPanel Text="Additional details">
                    <MudNumericField @bind-Value="_model.WeightKg" Label="Weight (kg)" Min="0" />
                    <MudNumericField @bind-Value="_model.Price" Label="Price" Min="0" Class="mt-3" />
                    <MudTextField @bind-Value="_model.PurchasePlace" Label="Purchase place" MaxLength="200" Class="mt-3" />
                    <MudDatePicker @bind-Date="_purchaseDate" Label="Purchase date" Class="mt-3" />
                    <MudNumericField @bind-Value="_model.InitialDistanceKm" Label="Initial distance (km)" Min="0" Class="mt-3" />
                    <MudNumericField @bind-Value="_model.InitialMovingHours" Label="Initial moving time (h)" Min="0" Class="mt-3" />
                    <MudNumericField @bind-Value="_model.InitialElevationM" Label="Initial elevation (m)" Min="0" Class="mt-3" />
                    <MudTextField @bind-Value="_model.Notes" Label="Notes" Lines="3" MaxLength="2000" Class="mt-3" />
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null = add; non-null = edit.</summary>
    [Parameter] public ComponentViewModel? Component { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private SaveComponentViewModel _model = new();
    private ComponentCategory? _categoryValue;   // null until the user picks one (placeholder shown; Required-guarded)
    private DateTime? _purchaseDate;
    private IEnumerable<WarehouseViewModel> _warehouses = Enumerable.Empty<WarehouseViewModel>();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await Http.GetFromJsonAsync<WarehouseViewModel[]>("warehouses")
            ?? Enumerable.Empty<WarehouseViewModel>();

        if (Component is not null)
        {
            _model = new SaveComponentViewModel
            {
                Name = Component.Name,
                Brand = Component.Brand,
                Model = Component.Model,
                Category = Component.Category,
                WeightKg = Component.WeightKg,
                Notes = Component.Notes,
                Price = Component.Price,
                PurchasePlace = Component.PurchasePlace,
                PurchaseDate = Component.PurchaseDate,
                InitialDistanceKm = Component.InitialDistanceKm,
                InitialMovingHours = Component.InitialMovingHours,
                InitialElevationM = Component.InitialElevationM,
                WarehouseId = Component.WarehouseId
            };
            _categoryValue = Component.Category;
            _purchaseDate = Component.PurchaseDate;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _model.Category = _categoryValue!.Value;
        _model.PurchaseDate = _purchaseDate;
        _saving = true;

        try
        {
            var response = Component is null
                ? await Http.PostAsJsonAsync("components", _model)
                : await Http.PutAsJsonAsync($"components/{Component.Id}", _model);

            if (response.IsSuccessStatusCode)
            {
                var saved = await response.Content.ReadFromJsonAsync<ComponentViewModel>();
                Snackbar.Add(Component is null ? "Component added" : "Component updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(saved));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task<IEnumerable<ComponentCategory?>> SearchCategories(string value, CancellationToken token)
    {
        var all = ComponentCategoryMetadata.CategoriesByGroup()
            .SelectMany(g => g.Categories)
            .Select(c => (ComponentCategory?)c);

        if (!string.IsNullOrWhiteSpace(value))
        {
            all = all.Where(c =>
                ComponentCategoryMetadata.DisplayName(c!.Value).Contains(value, StringComparison.OrdinalIgnoreCase)
                || ComponentCategoryMetadata.DisplayName(ComponentCategoryMetadata.Group(c.Value)).Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(all);
    }

    private void Cancel() => MudDialog.Cancel();
}
