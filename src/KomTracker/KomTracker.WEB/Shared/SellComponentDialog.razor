@using System.Net.Http.Json
@using KomTracker.API.Shared.ViewModels.Component
@using KomTracker.Domain.Entities.Component
@using KomTracker.WEB.Infrastructure

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Mark <b>@Component.Name</b> as sold.</MudText>
        <MudForm @ref="_form">
            <MudDatePicker @bind-Date="_saleDate" Label="Sale date" Required="true" RequiredError="Sale date is required" />
            <MudNumericField @bind-Value="_salePrice" Label="Sale price" Min="0" Required="true"
                             RequiredError="Sale price is required" Class="mt-3" />
            <MudTextField @bind-Value="_notes" Label="Notes" Lines="3" MaxLength="2000" Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Mark as sold</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ComponentViewModel Component { get; set; } = default!;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private DateTime? _saleDate = DateTime.UtcNow.Date;
    private decimal? _salePrice;
    private string? _notes;
    private bool _saving;

    protected override void OnInitialized() => _notes = Component.Notes;

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;

        try
        {
            var body = new ChangeComponentLifecycleViewModel
            {
                Lifecycle = ComponentLifecycle.Sold,
                SaleDate = _saleDate,
                SalePrice = _salePrice,
                Notes = _notes ?? string.Empty
            };

            var response = await Http.PutAsJsonAsync($"components/{Component.Id}/lifecycle", body);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Component marked as sold", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
