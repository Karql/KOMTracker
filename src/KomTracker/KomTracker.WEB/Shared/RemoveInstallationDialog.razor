@using System.Net.Http.Json
@using KomTracker.API.Shared.ViewModels.Installation
@using KomTracker.WEB.Infrastructure

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Remove <b>@Installation.ComponentName</b>@(string.IsNullOrEmpty(Installation.BikeName) ? "" : $" from {Installation.BikeName}").
            The installation window is closed; the component becomes unassigned.
        </MudText>
        <MudForm @ref="_form">
            <div class="d-flex" style="gap: 12px;">
                <MudDatePicker @bind-Date="_dateTo" Label="Removal date" Required="true"
                               RequiredError="Removal date is required" Style="flex: 2;" />
                <MudTimePicker @bind-Time="_dateToTime" Label="Time" Style="flex: 1;" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Remove</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public InstallationViewModel Installation { get; set; } = default!;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private DateTime? _dateTo = DateTime.UtcNow.Date;
    private TimeSpan? _dateToTime = TimeSpan.Zero;
    private bool _saving;

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        var body = new RemoveInstallationViewModel { DateTo = _dateTo!.Value.Date + (_dateToTime ?? TimeSpan.Zero) };

        _saving = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"installations/{Installation.Id}/remove", body);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Component removed", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
