@using System.Net.Http.Json
@using System.Threading
@using KomTracker.API.Shared.ViewModels.Bike
@using KomTracker.API.Shared.ViewModels.Suggestions
@using KomTracker.Domain.Entities.Bike
@using KomTracker.WEB.Infrastructure

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true" RequiredError="Name is required"
                          MaxLength="200" Immediate="true" />

            <MudSelect T="BikeType" @bind-Value="_model.Type" Label="Type" Class="mt-3">
                @foreach (var type in Enum.GetValues<BikeType>())
                {
                    <MudSelectItem Value="type">@type</MudSelectItem>
                }
            </MudSelect>

            <MudAutocomplete T="string" @bind-Value="_model.Brand" Label="Brand" Class="mt-3"
                             SearchFunc="SearchBrands" CoerceValue="true" Clearable="true" MaxItems="@((int?)null)" />
            <MudAutocomplete T="string" @bind-Value="_model.Model" Label="Model" Class="mt-3"
                             SearchFunc="SearchModels" CoerceValue="true" Clearable="true" MaxItems="@((int?)null)" />

            <MudExpansionPanels Elevation="0" Class="mt-3">
                <MudExpansionPanel Text="Additional details">
                    <MudNumericField @bind-Value="_model.WeightKg" Label="Weight (kg)" Min="0" Converter="InputConverters.Decimal" />
                    <MudNumericField @bind-Value="_model.Price" Label="Price" Min="0" Class="mt-3" Converter="InputConverters.Decimal" />
                    <MudAutocomplete T="string" @bind-Value="_model.PurchasePlace" Label="Purchase place" Class="mt-3"
                                     SearchFunc="SearchPlaces" CoerceValue="true" Clearable="true" MaxItems="@((int?)null)" />
                    <MudDatePicker @bind-Date="_purchaseDate" Label="Purchase date" Class="mt-3" DateFormat="yyyy-MM-dd" Editable="true" />
                    <MudNumericField @bind-Value="_model.InitialDistanceKm" Label="Initial distance (km)" Min="0" Class="mt-3" Converter="InputConverters.DecimalRequired" />
                    <MudNumericField @bind-Value="_model.InitialMovingHours" Label="Initial moving time (h)" Min="0" Class="mt-3" Converter="InputConverters.Decimal" />
                    <MudNumericField @bind-Value="_model.InitialElevationM" Label="Initial elevation (m)" Min="0" Class="mt-3" Converter="InputConverters.Decimal" />
                    <MudTextField @bind-Value="_model.Notes" Label="Notes" Lines="3" MaxLength="2000" Class="mt-3" />
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null = add; non-null = edit.</summary>
    [Parameter] public BikeViewModel? Bike { get; set; }

    /// <summary>Optional pre-filled model for "add" (e.g. created from a Strava bike; may carry StravaGearId).</summary>
    [Parameter] public SaveBikeViewModel? Prefill { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private SaveBikeViewModel _model = new();
    private DateTime? _purchaseDate;
    private PurchaseSuggestionsViewModel _suggestions = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _suggestions = await Http.GetFromJsonAsync<PurchaseSuggestionsViewModel>("bike-tracker/suggestions")
            ?? new PurchaseSuggestionsViewModel();

        if (Bike is not null)
        {
            _model = new SaveBikeViewModel
            {
                Name = Bike.Name,
                Brand = Bike.Brand,
                Model = Bike.Model,
                Type = Bike.Type,
                WeightKg = Bike.WeightKg,
                Notes = Bike.Notes,
                Price = Bike.Price,
                PurchasePlace = Bike.PurchasePlace,
                PurchaseDate = Bike.PurchaseDate,
                InitialDistanceKm = Bike.InitialDistanceKm,
                InitialMovingHours = Bike.InitialMovingHours,
                InitialElevationM = Bike.InitialElevationM
            };
            _purchaseDate = Bike.PurchaseDate;
        }
        else if (Prefill is not null)
        {
            _model = Prefill;
            _purchaseDate = Prefill.PurchaseDate;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _model.PurchaseDate = _purchaseDate;
        _saving = true;

        try
        {
            var response = Bike is null
                ? await Http.PostAsJsonAsync("bikes", _model)
                : await Http.PutAsJsonAsync($"bikes/{Bike.Id}", _model);

            if (response.IsSuccessStatusCode)
            {
                var saved = await response.Content.ReadFromJsonAsync<BikeViewModel>();
                Snackbar.Add(Bike is null ? "Bike added" : "Bike updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(saved));
                return;
            }

            await response.ShowProblemAsync(Snackbar);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task<IEnumerable<string>> SearchBrands(string value, CancellationToken token) => Suggest(_suggestions.Brands, value);
    private Task<IEnumerable<string>> SearchModels(string value, CancellationToken token) => Suggest(_suggestions.Models, value);
    private Task<IEnumerable<string>> SearchPlaces(string value, CancellationToken token) => Suggest(_suggestions.PurchasePlaces, value);

    private static Task<IEnumerable<string>> Suggest(IEnumerable<string> source, string value)
        => Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? source
            : source.Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void Cancel() => MudDialog.Cancel();
}
