@page "/account"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]

@if (!_loaded)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">Account</MudText>

    <MudTabs Elevation="1" Rounded="true" TabPanelsClass="mt-6" @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="General">
            <MudGrid>
                <MudItem xs="12" sm="4" md="3">
                    <MudCard >
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText>Profile</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex justify-center mb-4">
                                <MudAvatar Style="height:100px; width:100px;">
                                    <MudImage Src="@_user.Avatar"></MudImage>
                                </MudAvatar>                                
                            </div>
                            <MudText Align="Align.Center">@_user.FirstName @_user.LastName</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="8" md="9">
                    <MudCard >
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText>Profile Details</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudForm @bind-IsValid="@_profileDetailsValid">
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_user.FirstName" Label="First Name" Variant="Variant.Outlined" Disabled="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_user.LastName" Label="Last Name" Variant="Variant.Outlined" Disabled="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="_user.Username" Label="User name" Variant="Variant.Outlined" Disabled="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        @*TODO: Validate Disabled same address*@
                                        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" HelperText="For notifications"                                             
                                            Required="true" Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})" InputType="InputType.Email" />
                                    </MudItem>
                                </MudGrid>
                            </MudForm>
                        </MudCardContent>
                        <MudCardActions Class="pb-4 pl-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" Disabled="@(!_profileDetailsValid)" @onclick="@(async () => await ChangeEmailAsync())">Save Changes</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="Strava">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText>Strava access</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex align-center mb-3" style="gap: 8px; flex-wrap: wrap;">
                        <MudText>Activity access:</MudText>
                        @if (_stravaStatus.HasActivityReadAll)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">All rides (incl. private)</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Public rides only</MudChip>
                        }
                    </div>

                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">Granted Strava scopes (read-only)</MudText>
                    <div class="d-flex flex-wrap mb-4" style="gap: 6px;">
                        @if (_stravaStatus.Scopes.Any())
                        {
                            @foreach (var scope in _stravaStatus.Scopes)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@scope</MudChip>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">—</MudText>
                        }
                    </div>

                    @if (!_stravaStatus.HasActivityReadAll)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            Allowing access to your <b>private and "Only You" rides</b> (Strava's <code>activity:read_all</code>, read-only)
                            also brings more precise start/finish points, so bike mileage is counted accurately. Your activities are
                            never shown to other users.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link"
                                   OnClick="AllowPrivateRides">Allow private rides</MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            Private and "Only You" rides are synced — mileage is counted accurately.
                        </MudAlert>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.LinkOff"
                                   OnClick="RevokePrivateRides">Revoke private rides access</MudButton>
                    }

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Automatic sync</MudText>
                    <div class="d-flex align-center justify-space-between py-1" style="max-width: 420px;">
                        <MudText Typo="Typo.body2">Sync my activities automatically</MudText>
                        <MudSwitch T="bool" Value="_stravaStatus.ActivitiesEnabled" ValueChanged="OnActivitySyncChanged"
                                   Disabled="_togglingActivity" Color="Color.Primary" />
                    </div>
                    <div class="d-flex align-center justify-space-between py-1" style="max-width: 420px;">
                        <MudText Typo="Typo.body2">Sync my bikes automatically</MudText>
                        <MudSwitch T="bool" Value="_stravaStatus.BikesEnabled" ValueChanged="OnBikeSyncChanged"
                                   Disabled="_togglingBike" Color="Color.Primary" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudTabPanel>
        @*<MudTabPanel Text="Notifications">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText>Notifications</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText>
                                <b>Email</b>
                            </MudText>
                            <MudText Typo="Typo.body2">
                                What type of notifications you want to recieve to your email.
                            </MudText>
                            <div class="d-flex flex-column mt-6">
                                <MudCheckBox @bind-Checked="@KomsChangesNotification" Label="KOMs changes" Color="Color.Primary"></MudCheckBox>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
                <MudCardActions Class="pb-4 pl-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" @onclick="@(() => SaveChanges("Notification settings saved", Severity.Success))">Save Changes</MudButton>
                </MudCardActions>
            </MudCard>
        </MudTabPanel>*@
    </MudTabs>
}