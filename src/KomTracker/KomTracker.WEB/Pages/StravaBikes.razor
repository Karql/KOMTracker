@page "/bike-tracker/strava-bikes"
@attribute [Authorize]
@using KomTracker.API.Shared.ViewModels.BikeTracker
@using KomTracker.WEB.Models.Preference

<PageTitle>Strava bikes</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (!_status.HasActivityReadAll)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                <span>Private / "Only You" rides aren't synced until you allow private-rides access, so bike mileage may be under-counted.</span>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                           OnClick="ManageStravaAccess">Manage Strava access</MudButton>
            </div>
        </MudAlert>
    }

    @if (!_status.BikesEnabled && !_bikes.Any())
    {
        <MudPaper Outlined="true" Class="pa-8 d-flex flex-column align-center" Style="gap: 12px;">
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Sync your bikes from Strava</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
                Import your Strava bikes, then create or link BikeTracker bikes from them.
                Turn on automatic bike sync any time on your Account.
            </MudText>
            @SyncButton
        </MudPaper>
    }
    else
    {
        @if (!_status.BikesEnabled)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                    <span>Automatic bike sync is off — bikes update only when you sync manually. You can enable it on your Account.</span>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                               OnClick="ManageStravaAccess">Manage on Account</MudButton>
                </div>
            </MudAlert>
        }

        @if (!_bikes.Any())
        {
            <div class="d-flex align-center mb-4">
                <MudSpacer />
                @SyncButton
            </div>
            <MudAlert Severity="Severity.Info">No bikes found on your Strava account.</MudAlert>
        }
        else
        {
        <div class="d-flex align-center mb-4" style="gap: 12px; flex-wrap: wrap;">
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Margin="Margin.Dense"
                          Immediate="true" Style="max-width: 220px;" />
            <MudSpacer />
            <MudSwitch T="bool" @bind-Value="_showRetired" Color="Color.Primary" Label="Show retired" />
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudIconButton Icon="@Icons.Material.Filled.GridView"
                               Color="@(_view == ListViewMode.Card ? Color.Primary : Color.Default)"
                               OnClick="@(() => SetViewAsync(ListViewMode.Card))" />
                <MudIconButton Icon="@Icons.Material.Filled.TableRows"
                               Color="@(_view == ListViewMode.Table ? Color.Primary : Color.Default)"
                               OnClick="@(() => SetViewAsync(ListViewMode.Table))" />
            </MudButtonGroup>
            @SyncButton
        </div>

        @if (_showRetired)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-3 mud-text-secondary">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: text-bottom;" />
                Strava doesn't list retired bikes — they're discovered from your synced activities. If some are missing, sync again after your rides have imported.
            </MudText>
        }

        @if (!FilteredBikes.Any())
        {
            <MudAlert Severity="Severity.Info">No bikes match the current filter.</MudAlert>
        }
        else if (_view == ListViewMode.Card)
        {
            <MudGrid>
                @foreach (var bike in FilteredBikes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Outlined="true">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBike" />
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@DisplayName(bike)</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @($"{bike.BrandName} {bike.ModelName}".Trim())
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@bike.SuggestedType</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@FormatKm(bike.DistanceKm)</MudChip>
                                    @if (bike.Primary)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primary</MudChip>
                                    }
                                    @if (bike.Retired)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Retired</MudChip>
                                    }
                                </div>
                            </MudCardContent>
                            <MudCardActions>
                                @BikeActions(bike)
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudTable Items="FilteredBikes" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Brand</MudTh>
                    <MudTh>Model</MudTh>
                    <MudTh>Distance</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@DisplayName(context)</MudTd>
                    <MudTd DataLabel="Brand">@context.BrandName</MudTd>
                    <MudTd DataLabel="Model">@context.ModelName</MudTd>
                    <MudTd DataLabel="Distance">@FormatKm(context.DistanceKm)</MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.Primary)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primary</MudChip>
                        }
                        @if (context.Retired)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Retired</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align: right;">@BikeActions(context)</MudTd>
                </RowTemplate>
            </MudTable>
        }
        }
    }
}

@code {
    private RenderFragment SyncButton =>@<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SyncAsync" Disabled="_syncing">
        @if (_syncing)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Syncing…</span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Small" Class="mr-2" />
            <span>Sync from Strava</span>
        }
    </MudButton>;

    private RenderFragment BikeActions(StravaBikeViewModel bike) =>@<text>
        @if (bike.LinkedBikeId is int linkedId)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Link" OnClick="@(() => OpenBike(linkedId))">
                Linked@(string.IsNullOrWhiteSpace(bike.LinkedBikeName) ? "" : $": {bike.LinkedBikeName}")
            </MudButton>
            <MudTooltip Text="Unlink">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error"
                               OnClick="@(() => UnlinkAsync(bike))" />
            </MudTooltip>
        }
        else
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => CreateAsync(bike))">Create bike</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Link" OnClick="@(() => LinkAsync(bike))">Link</MudButton>
        }
    </text>;
}
