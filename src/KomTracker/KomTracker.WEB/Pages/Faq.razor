@page "/faq"
@using KomTracker.Application.Shared.Helpers
@using KomTracker.Application.Shared.Models.Segment
@using KomTracker.Application.Shared.Models.Difficulty
@using KomTracker.WEB.Helpers
@attribute [Authorize]

<MudExpansionPanels MultiExpansion="true">
    <MudExpansionPanel Text="How often data is refreshed?">
        <MudText Typo="Typo.body2">
            - KOMs changes: every hour<br />
            - Segments detailed informations (like attempts, athlets etc.): half past every hour (50 latest refreshed)<br />
            - Clubs (00:35, 12:35 Europe/Warsaw)<br />
            - Athletes profile - name, avatar etc. (23:45 Europe/Warsaw)<br />
            - Ranking/Stats (23:55 Europe/Warsaw and after KOMs changes when any)<br />
            - Bike Tracker activities: recent (last 7 days) Mon-Sat 01:35, full Sun 01:35 Europe/Warsaw (opt-in, see below)
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="How do I track bike mileage from Strava?">
        <MudText Typo="Typo.body2">
            Open <b>Bike Tracker → Strava bikes</b> and click <b>Sync from Strava</b>. This imports your Strava
            bikes and turns on activity sync for your account (activities are only synced once you opt in here).
            Then, for each Strava bike, use <b>Create bike</b> to make a BikeTracker bike from it, or <b>Link</b>
            it to a bike you already added.
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="What is Battle Field?">
        <MudText Typo="Typo.body2">
            Battle Field is a head-to-head scoreboard - who has taken more KOMs from whom. Think of it like goals in football: every time you take someone's KOM you score a point; if they take it back, they score one too.<br />
            <br />
            So a segment you keep fighting over counts a point for <b>each</b> takeover, on <b>both</b> sides - this is intentional. It's a tally of skirmishes won over time, not a snapshot of who currently holds the KOM.<br />
            <br />
            Good to know:<br />
            - The winner (more takeovers) is shown on the left; the numbers read as "their takeovers : the other side's takeovers".<br />
            - Only athletes using the app are counted (Strava hides public leaderboards), and only within the same category (men's KOM vs women's QOM are separate).<br />
            - Takeovers that were undone (the winning ride got flagged, deleted, or set to private) don't count.<br />
            - Filters: Period (time range), Activity type, and Club (both athletes must be club members). Click a KOMs number to see the exact segments.
        </MudText>
    </MudExpansionPanel>

    <MudExpansionPanel Text="What are the segments categories?">
        <MudText Typo="Typo.h6">Strava categories</MudText>

        <MudText Typo="Typo.body2" GutterBottom="true">Climb categorization acording to <MudLink Href="https://support.strava.com/hc/en-us/articles/216917057-Climb-Categorization">strava</MudLink></MudText>

        
        <MudText Typo="Typo.body2" GutterBottom="true">
            Categories from 4 to HC:<br />
            - The average gradient is at least 3.0%<br />
            - The segment distance is at least 300 meters.<br />
            - The length of the climb (in meters) multiplied by the grade of the climb is greater than 8000 (rank)<br />
        </MudText>

        <div class="d-flex align-center my-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.C4)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.C4)</span>
            </div> 
            <span>rank > 8000</span>
        </div>

        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.C3)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.C3)</span>
            </div> 
            <span>rank > 16000</span>
        </div>

        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.C2)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.C2)</span>
            </div> 
            <span>rank > 32000</span>
        </div>

        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.C1)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.C1)</span>
            </div> 
            <span>rank > 64000</span>
        </div>

        <div class="d-flex align-center">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.HC)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.HC)</span>
            </div> 
            <span>rank > 64000</span>
        </div>
        
        <MudText Typo="Typo.h6" Class="mt-6">KOM Tracker categories</MudText>
        <MudText Typo="Typo.body2" GutterBottom="true">
            KOM Tracker adds extra categories for segments not categorized by strava (cat 0)
        </MudText>

        <div class="d-flex align-center my-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.WL)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.WL)</span>
            </div> 
            <span>Wall - average gradient >= 8%</span>
        </div>
        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.MC)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.MC)</span>
            </div> 
            <span>Minor climb - average gradient >= 3% and &lt; 8%</span>
        </div>

        <MudText Typo="Typo.body2" Class="mt-2 mb-4">Flat segments average gradient >= -4% and &lt; 3%:</MudText>
        <div class="d-flex align-center my-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.TTS)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.TTL)</span>
            </div> 
            <span>TT long - distance >= 7500m</span>
        </div>
        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.TTL)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.TTS)</span>
            </div> 
            <span>TT short - distance >= 3500m and &lt; 7500m</span>
        </div>
        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.FL)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.FL)</span>
            </div> 
            <span>Flat standard - distance >= 1000m and &lt; 3500m</span>
        </div>
        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.SP)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.SP)</span>
            </div> 
            <span>Sprint - distance &lt; 1000m</span>
        </div>

        <MudText Typo="Typo.body2" Class="mt-2 mb-4">Downhill segments:</MudText>
        <div class="d-flex align-center my-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.D2)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.D2)</span>
            </div> 
            <span>Downhill standard - average gradient >= -8% and &lt -4%</span>
        </div>

        <div class="d-flex align-center mb-4">
            <div class="d-flex align-center justify-space-between climb-category mr-2" style="background-color: @ViewHelper.GetExtendedCategoryColor(ExtendedCategoryEnum.D1)">
                <MudIcon  Icon="@Icons.Material.Filled.Landscape"></MudIcon>
                <span>@SegmentHelper.GetExtendedCategoryText(ExtendedCategoryEnum.D1)</span>
            </div>
            <span>Downhill steep - average gradient &lt -8%</span>
        </div>
    </MudExpansionPanel>

    <MudExpansionPanel Text="What are The Bar and The Burn?">
        <MudText Typo="Typo.body2" GutterBottom="true">
            Two columns on the koms list that gauge <b>how hard a KOM really is</b> - one for how tough it is to
            take, one for how hard the holder actually worked to earn it.
        </MudText>

        <MudText Typo="Typo.body2" GutterBottom="true">
            <b>The Bar</b> - how high the bar is set, i.e. how demanding the time itself is. We take the time and
            the segment (length, gradient) and work out the power a <b>reference rider</b> (fixed weight, aero, etc.)
            would need to ride it under average conditions. So it rates the record itself - what you'd have to bring
            to take it - no matter how the current holder got it. A low Bar is an easy target; a high one means you
            need real power (or a good tailwind / group / descent).
        </MudText>
        <MudText Typo="Typo.body2" GutterBottom="true">
            <b>The Burn</b> - how hard the current holder actually worked to earn it, from their real power-meter
            data. It only shows up for rides recorded with a power meter.
        </MudText>
        <MudText Typo="Typo.body2" GutterBottom="true">
            They usually agree, but the gap is telling: a high Bar with a low Burn often means the time was set
            in easy conditions (a tailwind, or sitting in a fast group) - a good one to attack. A dash
            (<b>&ndash;</b>) means we can't rate it: a downhill, a very short segment, or - for The Burn - no
            power meter (and ratings are for rides only).
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-4">
            <b>How the rating is shown</b> - each one has two parts:
        </MudText>
        <MudText Typo="Typo.body2" GutterBottom="true">
            &bull; a <b>category</b> (the badge) - the racing class, from Cat 5 (beginner racer) up to World Class.
            Every effort length has its own power benchmarks (a 30-second sprint and a 20-minute climb are judged
            against different numbers), so the category is comparable across any segment.<br />
            &bull; a <b>score</b> (the number on the badge) - a finer figure so efforts <i>within</i> the same
            category can still be told apart; higher = stronger. <b>100 is top world-class</b> (the best-in-the-world
            benchmark for that effort length); most efforts sit well below, and a score <b>above 100</b> means beyond
            even that - usually a time helped by a tailwind, a fast group, or a downhill run rather than raw strength.
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-4 mb-2">The categories, hardest first:</MudText>
        @foreach (var (category, description) in _rankLegend)
        {
            <div class="d-flex align-center mb-2">
                <div class="d-flex align-center justify-center kom-rank mr-2" style="background-color: @ViewHelper.GetRankCategoryColor(category)">
                    <span>@ViewHelper.GetRankCategoryShort(category)</span>
                </div>
                <span>@ViewHelper.GetRankCategoryLabel(category) &ndash; @description</span>
            </div>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private readonly (KomCategory Category, string Description)[] _rankLegend =
    [
        (KomCategory.WorldClass, "world-tour / pro peloton level"),
        (KomCategory.Pro, "near-professional"),
        (KomCategory.Cat1, "top-level amateur racer"),
        (KomCategory.Cat2, "strong racer"),
        (KomCategory.Cat3, "solid club racer"),
        (KomCategory.Cat4, "entry-level racer"),
        (KomCategory.Cat5, "beginner racer"),
        (KomCategory.Recreational, "casual - just out riding"),
    ];
}