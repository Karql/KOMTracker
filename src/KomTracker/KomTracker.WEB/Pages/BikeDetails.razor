@page "/bikes/{Id:int}"
@attribute [Authorize]
@using System.Globalization
@using KomTracker.API.Shared.ViewModels.Bike
@using KomTracker.API.Shared.ViewModels.Installation
@using KomTracker.Domain.Entities.Bike
@using KomTracker.Domain.Entities.Component
@using KomTracker.WEB.Models.Component

<PageTitle>Bike</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_bike is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Bike not found.</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="bikes">Back to bikes</MudButton>
}
else
{
    <div class="d-flex align-center mb-4" style="gap: 12px; flex-wrap: wrap;">
        <MudIcon Icon="@Icons.Material.Filled.PedalBike" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">@_bike.Name</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@($"{_bike.Brand} {_bike.Model}".Trim())</MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Color="LifecycleColor(_bike.Lifecycle)">@_bike.Lifecycle</MudChip>
        @if (_bike.StravaGearId is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Link">Strava</MudChip>
        }
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" OnClick="EditAsync">Edit</MudButton>
        @if (_bike.Lifecycle == BikeLifecycle.Active)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Archive" OnClick="ArchiveAsync">Archive</MudButton>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.Unarchive" OnClick="ActivateAsync">Set active</MudButton>
        }
        @if (_bike.Lifecycle != BikeLifecycle.Sold)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Sell" OnClick="SellAsync">Mark as sold</MudButton>
        }
        @if (_bike.StravaGearId is not null)
        {
            <MudButton StartIcon="@Icons.Material.Filled.LinkOff" OnClick="UnlinkAsync">Unlink</MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteAsync">Delete</MudButton>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Identity</MudText>
                @Field("Type", _bike.Type.ToString())
                @Field("Brand", _bike.Brand)
                @Field("Model", _bike.Model)
                @Field("Weight", _bike.WeightKg is { } w ? $"{w.ToString(CultureInfo.InvariantCulture)} kg" : null)
                @Field("Notes", _bike.Notes)
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Purchase</MudText>
                @Field("Price", _bike.Price?.ToString(CultureInfo.InvariantCulture))
                @Field("Place", _bike.PurchasePlace)
                @Field("Date", _bike.PurchaseDate?.ToString("yyyy-MM-dd"))
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Mileage</MudText>
                @Field("Distance", $"{_bike.TotalDistanceKm.ToString("N0", CultureInfo.InvariantCulture)} km")
                @Field("Moving time", $"{_bike.TotalMovingHours.ToString("N1", CultureInfo.InvariantCulture)} h")
                @Field("Elevation", $"{_bike.TotalElevationM.ToString("N0", CultureInfo.InvariantCulture)} m")
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(_bike.AttributedActivityCount > 0
                        ? $"incl. {_bike.AttributedActivityCount} Strava ride(s)"
                        : "manual only — no Strava rides yet")
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Initial metrics</MudText>
                @Field("Distance", $"{_bike.InitialDistanceKm.ToString(CultureInfo.InvariantCulture)} km")
                @Field("Moving time", _bike.InitialMovingHours is { } h ? $"{h.ToString(CultureInfo.InvariantCulture)} h" : null)
                @Field("Elevation", _bike.InitialElevationM is { } e ? $"{e.ToString(CultureInfo.InvariantCulture)} m" : null)
            </MudPaper>
        </MudItem>

        @if (_bike.Lifecycle == BikeLifecycle.Sold)
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Sale</MudText>
                    @Field("Sale date", _bike.SaleDate?.ToString("yyyy-MM-dd"))
                    @Field("Sale price", _bike.SalePrice?.ToString(CultureInfo.InvariantCulture))
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="pa-4" Outlined="true">
                <div class="d-flex align-center mb-2" style="gap: 8px;">
                    <MudText Typo="Typo.subtitle1">Installed components</MudText>
                    <MudSpacer />
                    <MudButton StartIcon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                               Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync">Install component</MudButton>
                </div>

                @if (!_installations.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing installed yet.</MudText>
                }
                else
                {
                    <MudTable Items="_installations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0"
                              RowStyleFunc="RowStyle">
                        <HeaderContent>
                            <MudTh>Component</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Position</MudTh>
                            <MudTh>Period</MudTh>
                            <MudTh Style="text-align: right;">Manual usage</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Component">
                                <div class="d-flex align-center" style="gap: 6px;">
                                    <MudIcon Icon="@ComponentCategoryIcons.Icon(context.ComponentCategory ?? ComponentCategory.Other)" Size="Size.Small" />
                                    <MudLink OnClick="@(() => OpenComponent(context.ComponentId))">@context.ComponentName</MudLink>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Type">
                                <div class="d-flex align-center" style="gap: 6px;">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@(context.Type == ComponentInstallationType.Manual ? Color.Info : Color.Default)">@context.Type</MudChip>
                                    @if (context.IsCurrent)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Current</MudChip>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Position">@(context.Position?.ToString() ?? "—")</MudTd>
                            <MudTd DataLabel="Period">
                                @(context.Type == ComponentInstallationType.Manual
                                    ? "—"
                                    : $"{context.DateFrom?.ToString("yyyy-MM-dd HH:mm") ?? "?"} → {context.DateTo?.ToString("yyyy-MM-dd HH:mm") ?? "…"}")
                            </MudTd>
                            <MudTd DataLabel="Manual usage" Style="text-align: right;">@ManualUsage(context)</MudTd>
                            <MudTd Style="text-align: right;">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditInstallationAsync(context))" />
                                </MudTooltip>
                                @if (context.IsCurrent)
                                {
                                    <MudTooltip Text="Move to another bike">
                                        <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" OnClick="@(() => MoveAsync(context))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Remove">
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" OnClick="@(() => RemoveAsync(context))" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="Delete record">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteInstallationAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private RenderFragment Field(string label, string? value) =>@<div class="d-flex py-1" style="gap: 8px;">
        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 110px;">@label</MudText>
        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</MudText>
    </div>;

    // Highlight the currently-installed row.
    private string RowStyle(InstallationViewModel i, int _)
        => i.IsCurrent ? "background-color: rgba(76, 175, 80, 0.14);" : string.Empty;

    private static string ManualUsage(InstallationViewModel i)
    {
        if (i.Type != ComponentInstallationType.Manual)
        {
            return "—";
        }

        var parts = new List<string>();
        if (i.ManualDistanceKm is { } km) parts.Add($"{km.ToString("N0", CultureInfo.InvariantCulture)} km");
        if (i.ManualMovingHours is { } h) parts.Add($"{h.ToString("N1", CultureInfo.InvariantCulture)} h");
        if (i.ManualElevationM is { } m) parts.Add($"{m.ToString("N0", CultureInfo.InvariantCulture)} m");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }
}
