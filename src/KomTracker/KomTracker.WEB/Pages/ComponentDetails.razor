@page "/components/{Id:int}"
@attribute [Authorize]
@using System.Globalization
@using KomTracker.API.Shared.ViewModels.Component
@using KomTracker.API.Shared.ViewModels.Installation
@using KomTracker.Domain.Entities.Component
@using KomTracker.WEB.Models.Component

<PageTitle>Component</PageTitle>

@if (!_loaded)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_component is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Component not found.</MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="components">Back to components</MudButton>
}
else
{
    <div class="d-flex align-center mb-4" style="gap: 12px; flex-wrap: wrap;">
        <MudIcon Icon="@ComponentCategoryIcons.Icon(_component.Category)" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5">@_component.Name</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@($"{_component.Brand} {_component.Model}".Trim())</MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Color="LifecycleColor(_component.Lifecycle)">@_component.Lifecycle</MudChip>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" OnClick="EditAsync">Edit</MudButton>
        @if (_component.Lifecycle == ComponentLifecycle.Active)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Archive" OnClick="ArchiveAsync">Archive</MudButton>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.Unarchive" OnClick="ActivateAsync">Set active</MudButton>
        }
        @if (_component.Lifecycle != ComponentLifecycle.Sold)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Sell" OnClick="SellAsync">Mark as sold</MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteAsync">Delete</MudButton>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Identity</MudText>
                @Field("Category", ComponentCategoryMetadata.DisplayName(_component.Category))
                @Field("Group", ComponentCategoryMetadata.DisplayName(_component.CategoryGroup))
                @Field("Brand", _component.Brand)
                @Field("Model", _component.Model)
                @Field("Weight", _component.WeightKg is { } w ? $"{w.ToString(CultureInfo.InvariantCulture)} kg" : null)
                <div class="d-flex py-1" style="gap: 8px;">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 110px;">Location</MudText>
                    @if (_component.InstalledOnBikeId is not null)
                    {
                        <MudText Typo="Typo.body2">
                            On <MudLink Typo="Typo.body2" Href="@($"bikes/{_component.InstalledOnBikeId}")">@_component.InstalledOnBikeName</MudLink>@(_component.InstalledPosition is not null ? $" ({_component.InstalledPosition})" : "")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@(_component.WarehouseName is not null ? $"Warehouse: {_component.WarehouseName}" : "Unassigned")</MudText>
                    }
                </div>
                @Field("Notes", _component.Notes)
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Purchase</MudText>
                @Field("Price", _component.Price?.ToString(CultureInfo.InvariantCulture))
                @Field("Place", _component.PurchasePlace)
                @Field("Date", _component.PurchaseDate?.ToString("yyyy-MM-dd"))
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Initial metrics</MudText>
                @Field("Distance", $"{_component.InitialDistanceKm.ToString(CultureInfo.InvariantCulture)} km")
                @Field("Moving time", _component.InitialMovingHours is { } h ? $"{h.ToString(CultureInfo.InvariantCulture)} h" : null)
                @Field("Elevation", _component.InitialElevationM is { } e ? $"{e.ToString(CultureInfo.InvariantCulture)} m" : null)
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Ride mileage from installed windows — coming in a later phase.
                </MudText>
            </MudPaper>
        </MudItem>

        @if (_component.Lifecycle == ComponentLifecycle.Sold)
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Sale</MudText>
                    @Field("Sale date", _component.SaleDate?.ToString("yyyy-MM-dd"))
                    @Field("Sale price", _component.SalePrice?.ToString(CultureInfo.InvariantCulture))
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="pa-4" Outlined="true">
                <div class="d-flex align-center mb-2" style="gap: 8px; flex-wrap: wrap;">
                    <MudText Typo="Typo.subtitle1">Installations</MudText>
                    <MudSpacer />
                    @if (_current is null && _component.Lifecycle == ComponentLifecycle.Active)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                   Variant="Variant.Filled" Color="Color.Primary" OnClick="InstallAsync">Install on bike</MudButton>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="AddManualAsync">Add manual usage</MudButton>
                </div>

                @if (!_installations.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Never installed.</MudText>
                }
                else
                {
                    <MudTable Items="_installations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0"
                              RowStyleFunc="RowStyle">
                        <HeaderContent>
                            <MudTh>Bike</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Position</MudTh>
                            <MudTh>Period</MudTh>
                            <MudTh Style="text-align: right;">Manual usage</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Bike">
                                @if (context.BikeId is not null)
                                {
                                    <MudLink Href="@($"bikes/{context.BikeId}")">@context.BikeName</MudLink>
                                }
                                else
                                {
                                    @("—")
                                }
                            </MudTd>
                            <MudTd DataLabel="Type">
                                <div class="d-flex align-center" style="gap: 6px;">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@(context.Type == ComponentInstallationType.Manual ? Color.Info : Color.Default)">@context.Type</MudChip>
                                    @if (context.IsCurrent)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Current</MudChip>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Position">@(context.Position?.ToString() ?? "—")</MudTd>
                            <MudTd DataLabel="Period">
                                @(context.Type == ComponentInstallationType.Manual
                                    ? "—"
                                    : $"{context.DateFrom?.ToString("yyyy-MM-dd HH:mm") ?? "?"} → {context.DateTo?.ToString("yyyy-MM-dd HH:mm") ?? "…"}")
                            </MudTd>
                            <MudTd DataLabel="Manual usage" Style="text-align: right;">@ManualUsage(context)</MudTd>
                            <MudTd Style="text-align: right;">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditInstallationAsync(context))" />
                                </MudTooltip>
                                @if (context.IsCurrent)
                                {
                                    <MudTooltip Text="Move to another bike">
                                        <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" OnClick="@(() => MoveAsync(context))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Remove">
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" OnClick="@(() => RemoveAsync(context))" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="Delete record">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteInstallationAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private RenderFragment Field(string label, string? value) =>@<div class="d-flex py-1" style="gap: 8px;">
        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 110px;">@label</MudText>
        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</MudText>
    </div>;

    // Highlight the currently-installed row.
    private string RowStyle(InstallationViewModel i, int _)
        => i.IsCurrent ? "background-color: rgba(76, 175, 80, 0.14);" : string.Empty;

    private static string ManualUsage(InstallationViewModel i)
    {
        if (i.Type != ComponentInstallationType.Manual)
        {
            return "—";
        }

        var parts = new List<string>();
        if (i.ManualDistanceKm is { } km) parts.Add($"{km.ToString("N0", CultureInfo.InvariantCulture)} km");
        if (i.ManualMovingHours is { } h) parts.Add($"{h.ToString("N1", CultureInfo.InvariantCulture)} h");
        if (i.ManualElevationM is { } m) parts.Add($"{m.ToString("N0", CultureInfo.InvariantCulture)} m");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }
}
